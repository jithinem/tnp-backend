{
  "name": "reference-express-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "prisma:format": "npx prisma format --schema=./prisma",
    "migrate:dev": "npx prisma migrate dev --schema=./prisma --name",
    "migrate:deploy": "npx prisma migrate deploy --schema=./prisma",
    "seed": "node dist/seed/seed.db.js",
    "seed:ts": "tsx -r tsconfig-paths/register src/seed/seed.db.ts",
    "prisma:generate": "npx prisma generate --schema=./prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/multer": "^2.2.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.2",
    "prisma": "^7.10.0",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
