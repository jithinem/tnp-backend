{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",

    "paths": {
      "@/*": ["./src/*"]
    },

    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts","prisma.config.ts","src/**/*.d.ts"]
}